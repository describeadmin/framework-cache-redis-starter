<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    本 POM 【不继承 framework-parent】—— 这是刻意的，不是图省事。

    插件独立成仓后，它对框架的关系与业务方完全相同：通过 import framework-bom 拿版本仲裁，
    而不是靠继承拿到一整套构建配置。用同一套姿势消费框架，业务方会遇到的问题
    （BOM 少管了某个依赖、传递依赖冲突、release 与框架不一致）就会先在这里暴露。
    继承 framework-parent 反而会把这些问题遮住 —— 那等于自己给自己发合格证。

    代价是下面这些构建配置要自带一份。它们都是【硬约束】而非偏好，
    每一条对应 CLAUDE.md 里的一条规范，不要"精简"掉：
      - release=17                产物必须能跑在 Java 17 上（构建用哪个 JDK 不作要求，见下）
      - enforcer 的 requireJavaVersion  唯一的构建前提：JDK >= 17
      - surefire 的 UTF-8         中文 Windows 上默认 GBK，断言里的中文会对不上（CLAUDE.md 3.6）
      - enforcer 的两条 ban       JDBC 驱动、Jackson 3
    唯独【不带】framework 仓里的 enforce-core-thin —— 本模块的职责就是引入 Redis。
  -->

  <groupId>io.github.describeadmin</groupId>
  <artifactId>framework-cache-redis-starter</artifactId>
  <version>0.2.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>describeadmin :: framework-cache-redis-starter</name>
  <description>把 CacheProvider 与 TokenStore 切换到 Redis 的可选插件</description>
  <url>https://github.com/describeadmin/framework-cache-redis-starter</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>describeadmin</id>
      <name>describeadmin</name>
      <url>https://github.com/describeadmin</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/describeadmin/framework-cache-redis-starter.git</connection>
    <developerConnection>scm:git:git@github.com:describeadmin/framework-cache-redis-starter.git</developerConnection>
    <url>https://github.com/describeadmin/framework-cache-redis-starter</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      本仓库【不对构建 JDK 做版本要求】，唯一前提是 JDK >= 17（由 enforcer 的
      requireJavaVersion 兜底）。你用 17 / 21 / 25 构建都可以。

      能这么放开的原因是下面这一行：release=17 约束的是【产物】——编译器一律按
      Java 17 的 API 与字节码产出，构建 JDK 是 17 还是 25，产出的 class 文件
      major version 都是 61。所以再去钉构建 JDK，换不来任何产物上的差别，
      只会把手上没装那个版本的贡献者挡在门外。

      ⚠️ release=17 这一行本身【不能删】。删了字节码就跟着构建 JDK 走，
      Java 17 的使用方会在启动时拿到 UnsupportedClassVersionError ——
      "使用方只要 17+ 即可"这句承诺，正是靠它兑现的。CI 有一步专门断言 major version 为 61。
    -->
    <maven.compiler.release>17</maven.compiler.release>
    <enforcer.java.version>[17,)</enforcer.java.version>

    <!--
      ⚠️ 本插件构建所针对的框架版本。

      它必须与 FrameworkCacheRedisAutoConfiguration.REQUIRED_FRAMEWORK_VERSION 对得上 ——
      那个常量是运行期自检读的，这个属性是构建期解析用的，两者说的是同一件事。
      CI 的兼容性矩阵靠覆盖本属性来跑：
          mvn -B test -Ddescribeadmin.version=0.3.0
      见 .github/workflows/ci.yml 与 docs/registry.md 准入规范第 4、5 条。

      注意插件自身的版本号（上面的 <version>）与它【不联动】：
      插件发 1.3.0 完全可能仍然只要求框架 1.0.0。
    -->
    <describeadmin.version>0.2.0-SNAPSHOT</describeadmin.version>

    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <central-publishing-plugin.version>0.11.0</central-publishing-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        业务方的姿势：只 import framework-bom，不写任何框架模块的版本号。
        Spring Boot、MyBatis-Plus 的版本仲裁都由它传递过来 —— framework-bom 的
        【有效 POM】已包含它从 framework-parent 继承来的那些 import。

        插件因此不需要（也不应该）再自己 import spring-boot-dependencies：
        那会让插件与框架各说各话，而"两边各自钉了一个 Spring Boot 版本"
        正是最难查的一类版本问题。
      -->
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-bom</artifactId>
        <version>${describeadmin.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      契约模块用 compile 而非 provided：插件的全部意义就是提供 CacheProvider 的另一种实现，
      这个接口必须保证在运行时存在。它本身只依赖 spring-boot-autoconfigure，传递过去没有负担。
    -->
    <dependency>
      <groupId>io.github.describeadmin</groupId>
      <artifactId>framework-cache-starter</artifactId>
    </dependency>

    <!--
      security-starter 是 optional 的：只想把缓存换成 Redis、不使用框架鉴权的业务方
      不应被迫引入 Spring Security。RedisTokenStore 由 @ConditionalOnClass 保护，
      classpath 上没有 TokenStore 时不注册。

      provided 同时也在测试 classpath 上，因此装配测试无需再补一条 test 依赖。
    -->
    <dependency>
      <groupId>io.github.describeadmin</groupId>
      <artifactId>framework-security-starter</artifactId>
      <scope>provided</scope>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      同仓时期由 framework-parent 的 <dependencies> 提供，独立成仓后必须自己声明。
      这类"继承来的隐式依赖"是拆仓最容易漏的东西 —— 漏了会在编译测试时才报错。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- 测试用真实 Redis，不用 mock：本模块的价值全在"与真实 Redis 的语义是否一致" -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <!-- 与框架一致：改成 21 会把仍在 Java 17 上的框架使用方挡在门外 -->
          <release>${maven.compiler.release}</release>
          <parameters>true</parameters>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <!--
            测试 JVM 必须显式指定 UTF-8。默认取平台编码，中文 Windows 上是 GBK，
            断言里的中文会与被测代码里的中文对不上，而失败信息本身也是乱码，
            排查方向会完全跑偏。见 CLAUDE.md 3.6。
          -->
          <argLine>-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8</argLine>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-rules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                </requireMavenVersion>
                <!--
                  构建的唯一前提：跑 Maven 的那个 JDK >= 17。
                  不再钉具体版本（原来是 toolchains + JDK 21）—— 有 release=17 在，
                  17 / 21 / 25 构建出的产物完全一致，钉住只会平白挡住贡献者。

                  17 这个下界不是可选的：spring-boot-maven-plugin 与 release=17 都要求
                  Maven 进程自身跑在 17+。用 `mvn -v` 看 Java version 确认，
                  不要用 `java -version` —— 后者看的是 PATH，与 Maven 用哪个 JDK 无关。
                -->
                <requireJavaVersion>
                  <version>${enforcer.java.version}</version>
                  <message>
                    构建本插件需要 JDK 17 或更高版本（用 `mvn -v` 查看 Maven 实际使用的 JDK）。
                    具体用 17 / 21 / 25 都可以，产物一律是 Java 17 字节码。
                  </message>
                </requireJavaVersion>
                <!--
                  插件同样不得引入 JDBC 驱动 —— 拆仓后这条规则不会再从父 POM 继承过来，
                  必须自带一份。见 CLAUDE.md 3.4。
                -->
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>com.mysql:mysql-connector-j</exclude>
                    <exclude>mysql:mysql-connector-java</exclude>
                    <exclude>org.mariadb.jdbc:mariadb-java-client</exclude>
                    <exclude>com.oceanbase:oceanbase-client</exclude>
                    <exclude>com.dameng:*</exclude>
                    <exclude>cn.com.kingbase:*</exclude>
                  </excludes>
                  <message>
                    框架与插件均不得依赖任何 JDBC 驱动。驱动由业务方在自己的 pom.xml 中声明。
                  </message>
                </bannedDependencies>
                <!--
                  Jackson 3 的坐标是 tools.jackson.*，包名与 2.x 不兼容。
                  本插件直接用 ObjectMapper 序列化会话，混进 Jackson 3 会当场炸。
                -->
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>tools.jackson.core:*</exclude>
                  </excludes>
                  <message>
                    本项目锁定 Jackson 2.x（com.fasterxml.jackson.*）。
                    tools.jackson.* 是 Jackson 3，属于 Spring Boot 4.x 生态。
                  </message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      发布 profile。与 framework 仓的同名 profile 保持一致，需要：
        1. Central Portal User Token  → settings.xml 的 <server id="central">
        2. GPG 密钥
      发布步骤一律参照 docs 仓的 RELEASE.md，不要凭记忆执行。
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- 先上传为 draft，人工在 Portal 上确认后再 release -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
